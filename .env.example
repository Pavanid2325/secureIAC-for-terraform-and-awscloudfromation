# Reference only: export these as PowerShell $env:NAME values. No automatic dotenv loading.
LLM_PROVIDER=mock
AUTH_MODE=api_key
OPENAI_MODEL=gpt-4o-mini-2024-07-18
ENABLE_LIVE_CALLS=false
API_TIMEOUT=60
MAX_ATTEMPTS=2
MAX_INPUT_BYTES=200000
MAX_OUTPUT_BYTES=100000
LLM_MAX_TOKENS=4096
MAX_TEMPLATE_BYTES=1048576
TOP_K_RETRIEVAL=5
EMBEDDING_BACKEND=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_VECTOR_STORE_PATH=reports/vector_store.json
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
SCANNER_TIMEOUT=60
POLICY_PATH=policies/example.yaml
DEPLOYMENT_ENVIRONMENT=production
REPORTS_PATH=reports
# Credentials must be supplied separately by the environment or OS credential vault.
# Optional AWS providers only:
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
